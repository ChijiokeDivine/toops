// toops database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String  @id @default(cuid())
  displayName      String?
  telegramId       String? @unique
  telegramUsername String?
  telegramPhotoUrl String?
  /// Optional profile email, editable from the profile page.
  email            String? @unique
  /// Profile avatar as a data URL (or a hosted URL later).
  avatarUrl        String?
  /// Connected wallet address (used as the payout destination).
  bchAddress       String? @unique

  /// Off-chain game balance, in PUSD base units (2 decimals). Never derive this from chain state.
  balancePusd BigInt @default(0)
  /// Legacy BCH balance in satoshis (pre-PUSD). Kept for historical rows only.
  balanceSats BigInt @default(0)

  /// Provably-fair client seed for Dual Crash. Generated on first queue join.
  clientSeed String?
  /// Dual Crash match the user is currently in (waiting, countdown, or running).
  /// Both players point at the same match id, so this is deliberately not unique.
  activeMatchId String?

  /// Lifetime XP earned from daily check-ins. Off-chain only.
  xp                Int       @default(0)
  xpStreak          Int       @default(0)
  xpLastClaimedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformWallet PlatformWallet?
  sessions       Session[]
  challenges     AuthChallenge[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  ledgerEntries  LedgerEntry[]
  xpClaims       XpClaim[]
  dualTickets    DualTicket[]
  dualMatchPlayers DualMatchPlayer[]
  dualWins       DualMatch[] @relation("DualWinner")

  @@index([activeMatchId])
}

/// One row per successful daily XP claim. The unique `(userId, dayKey)` pair is
/// the database-level guard against double-claiming the same UTC day.
model XpClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  streak    Int
  /// UTC calendar day, formatted as `YYYY-MM-DD`.
  dayKey    String
  createdAt DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId, createdAt])
}

/// One HD-derived deposit address per user. The master xpriv/xpub live in
/// environment variables; the database only stores the derivation index and
/// public address, never private key material.
model PlatformWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         String   @unique
  derivationIndex Int      @unique
  network         String   @default("chipnet")
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthChallengeKind {
  MESSAGE
  TRANSACTION
}

model AuthChallenge {
  id        String            @id @default(cuid())
  address   String
  nonce     String            @unique
  kind      AuthChallengeKind @default(MESSAGE)
  message   String
  /// Hex-encoded unsigned challenge transaction (for TRANSACTION challenges).
  transaction String?
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([address])
  @@index([expiresAt])
}

enum DepositStatus {
  PENDING
  CONFIRMED
  SPENT
}

model Deposit {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  txid       String
  vout       Int
  address    String
  /// BCH satoshis received for a native-BCH deposit (0 for token deposits).
  amountSats BigInt   @default(0)
  /// PUSD base units credited to the user (2 decimals).
  amountPusd BigInt   @default(0)
  /// Cauldron swap that converted this BCH deposit into PUSD, when applicable.
  swapTxid   String?
  swapError  String?
  height     Int?
  status     DepositStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([txid, vout])
  @@index([userId, createdAt])
  @@index([address])
}

enum WithdrawalStatus {
  PENDING
  BROADCAST
  CONFIRMED
  FAILED
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  toAddress  String
  /// Payout asset chosen by the user: `PUSD` (token) or `BCH` (swapped).
  payoutAsset String          @default("PUSD")
  /// PUSD base units debited for the payout.
  amountPusd BigInt           @default(0)
  /// PUSD base units charged as the platform/network fee.
  feePusd    BigInt           @default(0)
  /// Actual BCH satoshis sent (0 for a PUSD payout).
  amountSats BigInt           @default(0)
  /// Actual BCH network fee paid from the platform reserve.
  feeSats    BigInt           @default(0)
  /// Cauldron swap used for a BCH payout, when applicable.
  swapTxid   String?
  status     WithdrawalStatus @default(PENDING)
  txid       String?          @unique
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, createdAt])
}

enum LedgerKind {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  ADJUSTMENT
}

/// Append-only balance history. `amountPusd` is signed, in PUSD base units.
model LedgerEntry {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             LedgerKind
  amountPusd       BigInt     @default(0)
  balanceAfterPusd BigInt     @default(0)
  /// Legacy satoshi columns, retained for pre-PUSD rows.
  amountSats       BigInt     @default(0)
  balanceAfterSats BigInt     @default(0)
  reference        String?    @unique
  metadata         Json?
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────────
// Dual Crash (two-player PvP crash)
// ──────────────────────────────────────────────────────────

enum DualMatchStatus {
  /// Both players matched and stakes locked; waiting for both clients to load.
  WAITING
  /// Both players ready; the countdown to launch is running.
  COUNTDOWN
  /// Rocket is flying and cashouts are accepted.
  RUNNING
  /// Settlement transaction is in progress (short-lived internal state).
  SETTLING
  /// A winner was paid.
  SETTLED
  /// Round crashed with no cashouts; the same match replays automatically.
  INTERMISSION
  /// Match was cancelled and both stakes were refunded.
  CANCELLED
}

/// A queued player waiting for an opponent at the exact same stake.
/// Presence of this row means the stake has been locked and is waiting.
model DualTicket {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stakePusd  BigInt
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([stakePusd, expiresAt])
}

/// One two-player match. Both stakes are locked before this row is created.
/// `round` increments when a crashed round with no cashouts auto-replays.
model DualMatch {
  id        String          @id @default(cuid())
  status    DualMatchStatus @default(WAITING)

  /// Each player's locked stake (equal).
  stakePusd BigInt
  /// stakePusd * 2.
  potPusd   BigInt
  /// 1% of the pot, taken when a winner is paid.
  feePusd   BigInt @default(0)
  /// Winner's credit (pot - fee).
  payoutPusd BigInt @default(0)

  winnerUserId String?
  winner       User?   @relation("DualWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)

  /// Current round's random seed. Only exposed by the API after the round ends.
  serverSeed     String
  /// sha256(serverSeed), published before the round starts.
  serverSeedHash String
  /// Increments every round, including auto-replays.
  nonce          Int    @default(0)
  /// Hidden until the round ends. Integer hundredths of a multiplier (234 = 2.34x).
  crashMultiplierX100 Int?
  /// Round number within this match (1-based).
  round          Int    @default(1)
  /// How many automatic both-bust replays have happened.
  replayCount    Int    @default(0)
  /// Previous rounds, revealed after each one ends.
  roundHistory   Json?

  /// Set once both players are ready.
  startsAt       DateTime?
  /// Server-authoritative crash instant for the current round.
  crashAt        DateTime?
  /// When the both-bust intermission ends and the next round can start.
  intermissionEndsAt DateTime?
  /// If both players are not ready by this time, the match is cancelled/refunded.
  readyDeadlineAt DateTime?
  endedAt        DateTime?

  /// Aggregate integrity marker; flipped to false if verification fails.
  integrityOk    Boolean @default(true)

  rematchOfId       String?
  rematchCreatedAt  DateTime?
  rematchDeclinedAt DateTime?

  disputed      Boolean   @default(false)
  disputeReason String?
  disputeAt     DateTime?

  players   DualMatchPlayer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, readyDeadlineAt])
  @@index([status, intermissionEndsAt])
  @@index([winnerUserId])
  @@index([createdAt])
}

model DualMatchPlayer {
  id        String    @id @default(cuid())
  matchId   String
  match     DualMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0 or 1. Used only for stable display ordering.
  seat      Int
  stakePusd BigInt
  /// Snapshot of the user's client seed at match creation.
  clientSeed String

  ready       Boolean  @default(false)
  lastSeenAt  DateTime @default(now())

  cashoutAt            DateTime?
  cashoutMultiplierX100 Int?
  payoutPusd           BigInt   @default(0)

  rematchRequested   Boolean   @default(false)
  rematchRequestedAt DateTime?

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
}
