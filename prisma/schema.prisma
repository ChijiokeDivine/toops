// toops database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String  @id @default(cuid())
  displayName      String?
  telegramId       String? @unique
  telegramUsername String?
  telegramPhotoUrl String?
  /// Optional profile email, editable from the profile page.
  email            String? @unique
  /// Profile avatar as a data URL (or a hosted URL later).
  avatarUrl        String?
  /// Connected wallet address (used as the payout destination).
  bchAddress       String? @unique

  /// Off-chain game balance, in satoshis. Never derive this from chain state.
  balanceSats BigInt @default(0)

  /// Lifetime XP earned from daily check-ins. Off-chain only.
  xp                Int       @default(0)
  xpStreak          Int       @default(0)
  xpLastClaimedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformWallet PlatformWallet?
  sessions       Session[]
  challenges     AuthChallenge[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  ledgerEntries  LedgerEntry[]
  xpClaims       XpClaim[]
}

/// One row per successful daily XP claim. The unique `(userId, dayKey)` pair is
/// the database-level guard against double-claiming the same UTC day.
model XpClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  streak    Int
  /// UTC calendar day, formatted as `YYYY-MM-DD`.
  dayKey    String
  createdAt DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId, createdAt])
}

/// One HD-derived deposit address per user. The master xpriv/xpub live in
/// environment variables; the database only stores the derivation index and
/// public address, never private key material.
model PlatformWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         String   @unique
  derivationIndex Int      @unique
  network         String   @default("chipnet")
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthChallengeKind {
  MESSAGE
  TRANSACTION
}

model AuthChallenge {
  id        String            @id @default(cuid())
  address   String
  nonce     String            @unique
  kind      AuthChallengeKind @default(MESSAGE)
  message   String
  /// Hex-encoded unsigned challenge transaction (for TRANSACTION challenges).
  transaction String?
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([address])
  @@index([expiresAt])
}

enum DepositStatus {
  PENDING
  CONFIRMED
  SPENT
}

model Deposit {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  txid       String
  vout       Int
  address    String
  amountSats BigInt
  height     Int?
  status     DepositStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([txid, vout])
  @@index([userId, createdAt])
  @@index([address])
}

enum WithdrawalStatus {
  PENDING
  BROADCAST
  CONFIRMED
  FAILED
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  toAddress  String
  amountSats BigInt
  feeSats    BigInt
  status     WithdrawalStatus @default(PENDING)
  txid       String?          @unique
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, createdAt])
}

enum LedgerKind {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  ADJUSTMENT
}

/// Append-only balance history. `amountSats` is signed.
model LedgerEntry {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             LedgerKind
  amountSats       BigInt
  balanceAfterSats BigInt
  reference        String?    @unique
  metadata         Json?
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}
