{
  "name": "toops",
  "private": true,
  "version": "0.0.0",
  "description": "toops — a Bitcoin Cash project for BCH BLAZE 2026",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "contracts:compile": "cashc ./contracts/main.cash -o ./src/contracts/main.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:local": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@mr-zwets/cauldron-swap-sdk": "^0.2.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.3.4",
    "@wizardconnect/core": "^0.2.5",
    "@wizardconnect/dapp": "^0.2.2",
    "@wizardconnect/react": "^0.2.3",
    "@xo-cash/crypto": "0.0.5",
    "@xo-cash/engine": "0.1.0-next.17612568780",
    "@xo-cash/primitives": "0.0.3",
    "@xo-cash/state": "0.0.5",
    "@xo-cash/templates": "0.0.12",
    "@xo-cash/types": "0.0.8",
    "@xo-cash/utils": "0.0.10",
    "cashscript": "^0.14.0",
    "next": "16.4.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cashc": "^0.14.0",
    "dotenv-cli": "^11.1.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
