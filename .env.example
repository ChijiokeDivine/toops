# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser.
# Everything else is server-only (API routes and server actions).

# Public: browser + server
NEXT_PUBLIC_BCH_NETWORK=chipnet
NEXT_PUBLIC_ELECTRUM_WSS_URL=wss://chipnet.imaginary.cash:50004
NEXT_PUBLIC_APP_NAME=toops
NEXT_PUBLIC_WC_NETWORK=testnet

# BLAZE requirement: CashTokens address that receives EMBER2026 votes
# for the Community Choice award. Leave blank during development.
NEXT_PUBLIC_EMBER2026_ADDRESS=

# Server-only: API routes, server actions, Prisma CLI
BCH_NETWORK=chipnet
ELECTRUM_WSS_URL=wss://chipnet.imaginary.cash:50004

# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Telegram Login Widget (BotFather -> /newbot, /setdomain)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# WalletConnect / Reown project ID (https://dashboard.reown.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# 32-byte base64 key used to encrypt platform wallet mnemonics.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=
