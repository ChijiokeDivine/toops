# Copy this file to `.env.local` and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Network: chipnet (development) | mainnet (only when you are ready to submit)
VITE_BCH_NETWORK=chipnet

# Chipnet Electrum WSS endpoints
VITE_ELECTRUM_WSS_URL=wss://chipnet.imaginary.cash:50004

# App metadata
VITE_APP_NAME=toops

# BLAZE requirement: CashTokens address that receives EMBER2026 votes
# for the Community Choice award. Leave blank during development.
VITE_EMBER2026_ADDRESS=
