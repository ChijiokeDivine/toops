# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser.
# Everything else is server-only (API routes and server actions).

# Public: browser + server
NEXT_PUBLIC_BCH_NETWORK=chipnet
NEXT_PUBLIC_APP_NAME=toops

# BLAZE requirement: CashTokens address that receives EMBER2026 votes
# for the Community Choice award. Leave blank during development.
NEXT_PUBLIC_EMBER2026_ADDRESS=

# Server-only: API routes, server actions, Prisma CLI
BCH_NETWORK=chipnet
ELECTRUM_WSS_URL=wss://chipnet.imaginary.cash:50004

# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Telegram Login Widget (BotFather -> /newbot, /setdomain)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# HD platform wallet (BIP44: m/44'/145'/0'/0/<index>).
# Keep the xpriv ONLY in a secret manager (Vercel env / Infisical). It must
# never be committed or stored in Postgres. The xpub is public and optional:
# when omitted it is derived from the xpriv at runtime.
# Generate a chipnet pair with:
#   node -e "import('@bitauth/libauth').then(m => { const r = m.deriveHdPrivateNodeFromBip39Mnemonic(m.generateBip39Mnemonic()); const a = m.deriveHdPath(r, \"m/44'/145'/0'\"); console.log('PLATFORM_WALLET_XPRIV=' + m.encodeHdPrivateKey({ node: r, network: 'testnet' }).hdPrivateKey); console.log('PLATFORM_WALLET_XPUB=' + m.encodeHdPublicKey({ node: m.deriveHdPublicNode(a), network: 'testnet' }).hdPublicKey) })"
PLATFORM_WALLET_XPRIV=
PLATFORM_WALLET_XPUB=

# Withdrawal network fee withheld from the user's balance, in satoshis.
WITHDRAWAL_FEE_SATS=1000

# Shared secret for GET /api/cron/sync-deposits. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
